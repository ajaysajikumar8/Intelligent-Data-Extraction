# ==============================================================================
# ROOT ENVIRONMENT FILE — Single Source of Truth
# ==============================================================================
# HOW THIS WORKS:
#   - This file is consumed by BOTH the FastAPI backend and the Next.js frontend.
#   - The frontend symlinks this file as frontend/.env.local for local dev.
#   - On platforms (Vercel, Render, Railway, PythonAnywhere), set these same
#     vars in the platform's environment panel — the rules below still apply.
#
# SECURITY BOUNDARY:
#   - Next.js ONLY exposes variables prefixed with NEXT_PUBLIC_ to the browser
#     bundle. All other variables in this file are IGNORED by the frontend bundler
#     even if they exist in the file — this is enforced at compile time.
#   - NEVER add NEXT_PUBLIC_ prefix to any secret/backend variable.
#   - NEVER reference non-NEXT_PUBLIC_ variables in frontend .ts/.tsx files.
#
# SETUP (Local Dev):
#   cd frontend && ln -s ../.env .env.local
# ==============================================================================


# ==============================================================================
# SECTION 1 — BACKEND SECRETS
# Read ONLY by FastAPI (server process). Never exposed to the browser.
# ==============================================================================

# Database
DATABASE_URL="postgresql://postgres:your-db-password@localhost:5432/extractor_db?schema=public"

# AI / Gemini
GEMINI_API_KEY="your-gemini-api-key-here"

# JWT Auth
SECRET_KEY="your-secret-key-change-in-production-32-chars-minimum"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS — tells the backend which frontend origin to allow
FRONTEND_URL="http://localhost:3000"

# OAuth (Optional)
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
GOOGLE_REDIRECT_URI="http://localhost:8000/api/v1/auth/google/callback"


# ==============================================================================
# SECTION 2 — FRONTEND PUBLIC VARIABLES
# ONLY these are safe to expose to the browser. NEXT_PUBLIC_ prefix is required.
# Next.js inlines these values into the client JS bundle at build time.
# ==============================================================================

NEXT_PUBLIC_API_BASE_URL="http://localhost:8000/api/v1"
