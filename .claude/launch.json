{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "backend",
      "runtimeExecutable": "bash",
      "runtimeArgs": ["-c", "cd backend && .venv/bin/python -m uvicorn app.main:app --reload --port 8005"],
      "port": 8005
    },
    {
      "name": "frontend",
      "runtimeExecutable": "bash",
      "runtimeArgs": ["-c", "cd frontend && npm run dev -- --port 5178 --strictPort"],
      "port": 5178
    },
    {
      "name": "website",
      "runtimeExecutable": "bash",
      "runtimeArgs": ["-c", "cd website && npm run dev"],
      "port": 3005
    }
  ]
}
