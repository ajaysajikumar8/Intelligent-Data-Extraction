# ==============================================================================
# NEXT.JS FRONTEND ENVIRONMENT CONFIGURATION
# ==============================================================================
# Next.js ONLY exposes variables prefixed with NEXT_PUBLIC_ to browser bundles.
# Copy this file to .env.local inside the frontend/ directory for local development.
# ==============================================================================

# Public API Base URL for backend requests
NEXT_PUBLIC_API_BASE_URL="http://localhost:8000/api/v1"
