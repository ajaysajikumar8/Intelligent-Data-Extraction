# ==============================================================================
# VITE + REACT FRONTEND ENVIRONMENT CONFIGURATION
# ==============================================================================
# Vite ONLY inlines variables prefixed with VITE_ into the browser bundle at build time.
# Copy this file to .env.local inside the frontend/ directory for local development.
# ==============================================================================

# Public API Base URL for backend requests
VITE_API_BASE_URL="http://localhost:8000/api/v1"
