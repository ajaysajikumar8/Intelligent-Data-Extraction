# ==============================================================================
# FASTAPI BACKEND ENVIRONMENT CONFIGURATION
# ==============================================================================
# Read ONLY by FastAPI (server process). Never exposed to the browser.
# Copy this file to .env inside the backend/ directory for local development.
# ==============================================================================

# Database Connection String
DATABASE_URL="postgresql://postgres:your-db-password@localhost:5432/extractor_db?schema=public"

# AI / Google Gemini API Key
GEMINI_API_KEY="your-gemini-api-key-here"

# JWT Authentication
SECRET_KEY="your-secret-key-change-in-production-32-chars-minimum"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS — Origin URL of the frontend application allowed to communicate with backend
FRONTEND_URL="http://localhost:3000"

# Google OAuth (Optional)
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
GOOGLE_REDIRECT_URI="http://localhost:8000/api/v1/auth/google/callback"
