# Copy to backend/.env for local development. Server-only: never exposed to the browser.

DATABASE_URL="postgresql://postgres:your-db-password@localhost:5432/extractor_db?schema=public"

GEMINI_API_KEY="your-gemini-api-key-here"
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY="your-fernet-key-here"

SECRET_KEY="your-secret-key-change-in-production-32-chars-minimum"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

FRONTEND_URL="http://localhost:5178"
API_BASE_URL="http://localhost:8005"

GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
GOOGLE_REDIRECT_URI="http://localhost:8005/api/v1/auth/google/callback"

# Empty RESEND_API_KEY = emails are logged, not sent. EMAIL_FROM needs a Resend-verified domain.
RESEND_API_KEY=""
EMAIL_FROM="Your App <noreply@yourdomain.com>"

# Free extractions per new workspace, granted on email verification (0 = trial off)
TRIAL_EXTRACTIONS=5
TRIAL_DAILY_GRANT_CAP=50
# SIGNUP_LIMIT_PER_IP_PER_HOUR=5
# SIGNUP_LIMIT_PER_DOMAIN_PER_HOUR=3
# Reverse proxies in front of the app (Render/Railway = 1); 0 on localhost
# TRUSTED_PROXY_HOPS=0

# SENDGRID_WEBHOOK_PUBLIC_KEY=""
